name: "visionport_pipeline"
platform: "ensemble"
max_batch_size: 32

input [
  {
    name: "RAW_FRAMES"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]

output [
  {
    name: "DETECTIONS"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "container_detector"
      model_version: -1
      input_map {
        key: "images"
        value: "RAW_FRAMES"
      }
      output_map {
        key: "output0"
        value: "DETECTIONS"
      }
    }
  ]
}

