name: "container_detector"
platform: "tensorrt_plan"
max_batch_size: 32

# Input tensor specification matching TensorRT engine profile
input [
  {
    name: "images"
    data_type: TYPE_FP32
    format: FORMAT_NCHW
    dims: [ 3, 640, 640 ]
    reshape { shape: [ 3, 640, 640 ] }
  }
]

# Output tensor specification
output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  }
]

# Dynamic Batching Configuration to optimize GPU saturation
dynamic_batching {
  preferred_batch_size: [ 4, 8, 16, 32 ]
  max_queue_delay_microseconds: 5000
}

# GPU Instance Group Configuration
instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Optimization settings
optimization {
  cuda {
    graphs: 1
    busy_wait_events: 1
  }
}

